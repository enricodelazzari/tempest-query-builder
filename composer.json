{
    "name": "enricodelazzari/tempest-query-builder",
    "description": "Filter, sort and include Tempest models straight from the HTTP request",
    "keywords": [
        "enricodelazzari",
        "tempest",
        "query-builder",
        "api",
        "filtering",
        "sorting"
    ],
    "homepage": "https://github.com/enricodelazzari/tempest-query-builder",
    "license": "MIT",
    "authors": [
        {
            "name": "Enrico De Lazzari",
            "email": "enricodlz@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "tempest/core": "^3.17",
        "tempest/database": "^3.17",
        "tempest/http": "^3.17",
        "tempest/router": "^3.17",
        "tempest/support": "^3.17"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "pestphp/pest": "^4.7",
        "phpstan/phpstan": "^2.2",
        "tempest/framework": "^3.17"
    },
    "autoload": {
        "psr-4": {
            "EnricoDeLazzari\\QueryBuilder\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EnricoDeLazzari\\QueryBuilder\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
